{
  "name": "auratranslate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AuraTranslate — dictionary lookup and translation workspace, fully offline",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:deps": "node scripts/check-deps.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:commands": "node scripts/check-commands.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "check:scope:bundled": "node scripts/check-scope-bundled.mjs",
    "check:dict": "node scripts/check-dict-build.mjs",
    "check:dict-manifest": "node scripts/check-dict-manifest.mjs",
    "check:gates": "node scripts/check-gates.mjs",
    "check:lint": "eslint src",
    "test:e2e": "cargo build --locked --features wdio --manifest-path src-tauri/Cargo.toml && wdio run e2e/wdio.conf.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "dockview-vue": "7.0.4",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@wdio/cli": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-service": "1.3.0",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.0",
    "vue-tsc": "3.3.9"
  }
}
