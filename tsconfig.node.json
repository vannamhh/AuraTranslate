{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "scripts/check-commands.mjs",
    "scripts/lib/commands-scan.mjs",
    "scripts/check-tokens.mjs",
    "scripts/lib/tokens-scan.mjs"
  ]
}
