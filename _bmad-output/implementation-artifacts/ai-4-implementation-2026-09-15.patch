+/// **D1 (spec AI-4, 2026-09-15) — bảng đếm plain/`(async)` trên MƯỜI HAI tệp mang command, đo
+/// lại TRÊN CÂY ĐÃ SỬA** (sau khi bốn thuộc tính của `project.rs` đã lật, theo đúng thứ tự D1
+/// yêu cầu — bảng viết SAU khi sửa, không phải trước). `project.rs` — tệp có nhiều lời gọi
+/// mạng nhất của cả epic — chưa từng nằm trong `blocking_wire_cases()` trước spec này; đây là
+/// tấm lưới chặn đúng lỗ hổng đó tái diễn: một command MỚI, hay một TỆP MỚI dưới
+/// `src/commands/**` khai `#[tauri::command]`, làm cổng đỏ cho tới khi một người phân loại nó.
+///
+/// Đếm bằng TEXT (dòng không bắt đầu `//`, cùng luật `count_async_attrs` phía trên), không
+/// build — đây KHÔNG phải một phép đo hành vi, chỉ là một phép đếm thuộc tính trên nguồn.
+/// Chính vì đếm trên văn bản nguồn, số không phụ thuộc `--features nfr-bench`: `lib.rs` mang
+/// HAI dòng `#[tauri::command]` trong nguồn dù một trong hai
+/// (`nfr_bench_mark_and_wait_phase`, `lib.rs:590`) chỉ tồn tại trong BẢN DỰNG dưới
+/// `#[cfg(feature = "nfr-bench")]` — bảng dưới đây đếm CẢ HAI một cách CÓ CHỦ ĐÍCH, không loại
+/// `lib.rs`, để một lượt sửa sau không "gọn" bảng bằng cách bớt dòng đó rồi vô tình làm số phụ
+/// thuộc build.
+#[test]
+fn the_blocking_wires_gate_count_table_covers_every_command_bearing_file() {
+    // (đường dẫn tương đối tới `src/`, plain, async, lý do NẾU 0 vỏ chặn trong tệp)
+    let table: [(&str, usize, usize, Option<&str>); 12] = [
+        ("commands/chapter.rs", 4, 5, None),
+        (
+            "commands/cleanup.rs",
+            5,
+            0,
+            Some("don dep quy tac Chuong/Glossary -- moi ham la mot lan doc/ghi mot hang, khong \
+                  co lan quet toan bang hay lan cho mang nao"),
+        ),
+        (
+            "commands/config.rs",
+            3,
+            0,
+            Some("doc/ghi cau hinh ung dung -- gia tri nho, khong co I/O ti le theo kich thuoc \
+                  tai lieu hay tap du lieu"),
+        ),
+        (
+            "commands/dict.rs",
+            3,
+            0,
+            Some("tra cuu tu dien qua chi muc da dung san -- khong mo hop thoai, khong quet toan \
+                  bang, khong goi mang"),
+        ),
+        ("commands/glossary.rs", 8, 7, None),
+        ("commands/library.rs", 1, 4, None),
+        ("commands/lifecycle.rs", 1, 2, None),
+        (
+            "commands/mod.rs",
+            0,
+            0,
+            Some("chi khai `pub mod` cho muoi mot tep con, khong mot dong `#[tauri::command]` \
+                  nao o day"),
+        ),
+        (
+            "commands/pinned.rs",
+            3,
+            0,
+            Some("ghim/bo ghim mot hang glossary_entry -- mot lan ghi mot hang, khong quet toan \
+                  bang"),
+        ),
+        ("commands/project.rs", 11, 6, None),
+        (
+            "commands/segment.rs",
+            14,
+            0,
+            Some("moi ham thao tac mot Segment/mot Chuong da xac dinh qua id -- khong lan nao \
+                  quet toan bo thu vien hay cho mang; Story 6.15 rieng cua chapter.rs moi cham \
+                  reindex toan Library"),
+        ),
+        (
+            "lib.rs",
+            2,
+            0,
+            Some("mot trong hai la `nfr_bench_mark_and_wait_phase` (lib.rs:590), CHI ton tai \
+                  duoi `#[cfg(feature = \"nfr-bench\")]` -- dem CA HAI vi day la quet van ban \
+                  nguon, khong phu thuoc feature build; cong kia `confirm_exit_flush` chi thao \
+                  tac mot co `AtomicBool`"),
+        ),
+    ];
+
+    let count_command_attrs = |rel: &str| -> (usize, usize) {
+        let path = manifest_dir().join("src").join(rel);
+        let text = fs::read_to_string(&path).unwrap_or_else(|e| panic!("read {}: {e}", path.display()));
+        let mut plain = 0usize;
+        let mut r#async = 0usize;
+        for line in text.lines().map(str::trim_start).filter(|l| !l.starts_with("//")) {
+            if line.starts_with("#[tauri::command(async)]") {
+                r#async += 1;
+            } else if line.starts_with("#[tauri::command]") {
+                plain += 1;
+            }
+        }
+        (plain, r#async)
+    };
+
+    let mut classified: std::collections::BTreeSet<PathBuf> = std::collections::BTreeSet::new();
+    let mut total_plain = 0usize;
+    let mut total_async = 0usize;
+
+    for (rel, want_plain, want_async, zero_reason) in table {
+        let (plain, r#async) = count_command_attrs(rel);
+        assert_eq!(
+            (plain, r#async),
+            (want_plain, want_async),
+            "`{rel}`: dem duoc {plain} plain / {async} async, bang D1 khai {want_plain} plain / \
+             {want_async} async -- mot command da them/xoa/lat o tep nay ma bang D1 chua theo \
+             kip. Do lai va sua BANG, dung ha thap tieu chuan cho khop mot con so sai.",
+        );
+        assert!(
+            want_async > 0 || zero_reason.is_some(),
+            "`{rel}` co {want_plain} vo dong bo va 0 vo `(async)`, nhung khong mang ly do trong \
+             bang D1 -- moi tep 0-blocking phai neu ro vi sao KHONG mot vo nao trong no can chay \
+             ngoai luong chinh."
+        );
+        classified.insert(manifest_dir().join("src").join(rel));
+        total_plain += plain;
+        total_async += r#async;
+    }
+
+    assert_eq!(
+        total_plain, 55,
+        "tong so vo DONG BO dem duoc tren muoi hai tep la {total_plain}, bang D1 khai 55 -- \
+         mot command moi da them o dau do ma bang chua theo kip."
+    );
+    assert_eq!(
+        total_async, 24,
+        "tong so vo `(async)` dem duoc tren muoi hai tep la {total_async}, bang D1 khai 24 -- \
+         mot vo da lat/them ma bang chua theo kip."
+    );
+
+    // "Tep MOI" -- bat ky tep .rs nao duoi src/** mang it nhat mot dong `#[tauri::command...]`
+    // (khong tinh dong trong chu thich, da loc o tren) ma khong nam trong bang muoi hai tep o
+    // tren la mot tep CHUA PHAN LOAI. Tai dung `all_src_rust_files()` (dinh nghia phia tren) --
+    // khong dung mot bo quet thu tu.
+    for file in all_src_rust_files() {
+        let text = fs::read_to_string(&file).unwrap_or_else(|e| panic!("read {}: {e}", file.display()));
+        let has_command_attr = text
+            .lines()
+            .map(str::trim_start)
+            .filter(|l| !l.starts_with("//"))
+            .any(|l| l.starts_with("#[tauri::command"));
+        if has_command_attr && !classified.contains(&file) {
+            panic!(
+                "`{}` khai it nhat mot `#[tauri::command...]` nhung KHONG nam trong bang D1 muoi \
+                 hai tep cua `the_blocking_wires_gate_count_table_covers_every_command_bearing_file` \
+                 -- phan loai no (dong bo an toan, hay can `(async)`) roi them vao bang D1 CUNG \
+                 LUOT.",
+                file.display()
+            );
+        }
+    }
 }
 
