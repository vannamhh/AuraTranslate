{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraTranslate",
  "version": "0.1.0",
  "identifier": "com.auratranslate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraTranslate",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/dict/**", "$RESOURCE/fonts/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "resources": {
      "resources/fonts/*": "fonts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "en-US" }
    }
  }
}
