#!/bin/sh
# Push gate: 11 gates, vitest, build, cargo test. A red step blocks the push.
# A push touching only documentation runs the gates and skips the rest (is_docs_only).
# check:scope, check:scope:bundled and the e2e suite stay out on purpose; CI and the nightly run cover them.
# History: _bmad-output/implementation-artifacts/agent-rules-evidence.md

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }

fail() {
  echo ''
  red "PUSH BỊ CHẶN — $1 ĐỎ."
  echo ''
  echo "Chạy lại một mình để đọc chi tiết:  $2"
  echo ''
  echo 'Nếu thật sự cần đẩy đi kèm một cổng đỏ, viết lý do vào commit message rồi:'
  echo '  git push --no-verify'
  exit 1
}

ZERO=0000000000000000000000000000000000000000

# naming_boundary.rs reads the root AGENTS.md, and *-ban-do/ holds test fixtures.
is_docs_only() {
  files=$(git diff --name-only "$1" "$2" 2>/dev/null) || return 1
  printf '%s\n' "$files" | awk '
    $0 == "" { next }
    $0 == "AGENTS.md" || /-ban-do\// { found = 1; exit }
    /^_bmad-output\// || /\.md$/ { next }
    { found = 1; exit }
    END { exit found }'
}

DOCS_ONLY=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ] || ! is_docs_only "$remote_sha" "$local_sha"; then
    DOCS_ONLY=0
    break
  fi
  DOCS_ONLY=1
done

START=$(date +%s)
echo ''
echo 'pre-push — mười một cổng, test frontend, build, cargo test.'

for gate in deps tokens i18n commands layout panel-refs dict dict-manifest lint gates debt-owner; do
  printf '  %-14s' "$gate"
  if npm run --silent "check:$gate" >/dev/null 2>&1; then
    green 'OK'
  else
    echo ''
    fail "check:$gate" "npm run check:$gate"
  fi
done

if [ "$DOCS_ONLY" = 1 ]; then
  echo '  (chỉ đổi tài liệu — bỏ qua test, build, cargo test)'
else
  printf '  %-14s' 'test'
  if npm run --silent test >/dev/null 2>&1; then green 'OK'; else echo ''; fail 'npm run test' 'npm run test'; fi

  printf '  %-14s' 'build'
  if npm run build >/dev/null 2>&1; then green 'OK'; else echo ''; fail 'npm run build' 'npm run build'; fi

  printf '  %-14s' 'cargo test'
  if (cd src-tauri && cargo test --locked >/dev/null 2>&1); then
    green 'OK'
  else
    echo ''
    fail 'cargo test' 'cd src-tauri && cargo test --locked'
  fi
fi

echo ''
green "Tất cả xanh trong $(( $(date +%s) - START ))s. Đẩy đi."
echo ''
