#!/bin/sh
# Push gate: 15 gates, vitest, build, cargo test. A red step blocks the push.
# A push touching only documentation runs the first fourteen gates and skips the rest (is_docs_only).
# check:scope, check:scope:bundled and the e2e suite stay out on purpose; CI and the nightly run cover them.
# Every step writes its output to a log file and a red step prints the tail of that log:
# re-running a twenty-minute step just to read why it went red is the cost this avoids.
# History: _bmad-output/implementation-artifacts/agent-rules-evidence.md

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }

TMP_BASE=${TMPDIR:-/tmp}
LOG_DIR=$(mktemp -d "${TMP_BASE%/}/auratranslate-pre-push.XXXXXX")

TAIL_LINES=60

fail() {
  echo ''
  red "PUSH BỊ CHẶN — $1 ĐỎ."
  echo ''
  if [ -s "$3" ]; then
    echo "$TAIL_LINES dòng cuối ($3):"
    echo '────────────────────────────────────────────────────────────────'
    tail -n "$TAIL_LINES" "$3"
    echo '────────────────────────────────────────────────────────────────'
    echo ''
    echo "Log đầy đủ còn ở:  $3"
  else
    echo "Bước này không in gì ra log ($3 rỗng)."
  fi
  echo ''
  echo "Chạy lại một mình để đọc chi tiết:  $2"
  echo ''
  echo 'Nếu thật sự cần đẩy đi kèm một cổng đỏ, viết lý do vào commit message rồi:'
  echo '  git push --no-verify'
  exit 1
}

ZERO=0000000000000000000000000000000000000000

is_docs_only() {
  node scripts/docs-only.mjs "$1" "$2" 2>/dev/null
}

DOCS_ONLY=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ] || ! is_docs_only "$remote_sha" "$local_sha"; then
    DOCS_ONLY=0
    break
  fi
  DOCS_ONLY=1
done

START=$(date +%s)
echo ''
echo 'pre-push — mười lăm cổng, test frontend, build, cargo test.'

for gate in deps tokens i18n commands layout panel-refs doc-refs dict dict-manifest lint clippy fmt gates debt-owner; do
  printf '  %-14s' "$gate"
  if npm run --silent "check:$gate" >"$LOG_DIR/$gate.log" 2>&1; then
    green 'OK'
  else
    echo ''
    fail "check:$gate" "npm run check:$gate" "$LOG_DIR/$gate.log"
  fi
done

# Warns when the previous push's CI run failed; never blocks, and skips silently when
# offline, unauthenticated or timed out. Not a gate, so it has no `check:*` name.
node scripts/ci-previous-verdict.mjs || true

if [ "$DOCS_ONLY" = 1 ]; then
  echo '  (chỉ đổi tài liệu — bỏ qua test, build, cargo test, fr77)'
else
  printf '  %-14s' 'test'
  if npm run --silent test >"$LOG_DIR/test.log" 2>&1; then
    green 'OK'
  else
    echo ''
    fail 'npm run test' 'npm run test' "$LOG_DIR/test.log"
  fi

  printf '  %-14s' 'build'
  if npm run build >"$LOG_DIR/build.log" 2>&1; then
    green 'OK'
  else
    echo ''
    fail 'npm run build' 'npm run build' "$LOG_DIR/build.log"
  fi

  printf '  %-14s' 'cargo test'
  if (cd src-tauri && cargo test --locked >"$LOG_DIR/cargo-test.log" 2>&1); then
    green 'OK'
  else
    echo ''
    fail 'cargo test' 'cd src-tauri && cargo test --locked' "$LOG_DIR/cargo-test.log"
  fi

  # Cổng thứ MƯỜI LĂM, và nó phải ở ĐÂY, không ở vòng lặp trên: nó trỏ `--target-dir` vào
  # `target/` thật để dùng lại các crate vừa biên dịch, và cần `dist/` của `npm run build`.
  printf '  %-14s' 'fr77'
  if npm run --silent check:fr77 >"$LOG_DIR/fr77.log" 2>&1; then
    green 'OK'
  else
    echo ''
    fail 'check:fr77' 'npm run check:fr77' "$LOG_DIR/fr77.log"
  fi
fi

rm -rf "$LOG_DIR"

echo ''
green "Tất cả xanh trong $(( $(date +%s) - START ))s. Đẩy đi."
echo ''
